# Environment variable values used for running a local development environment
#
# DO NOT USE THESE VALUES IN PRODUCTION
#
# The Vite dev server proxies /api to the backend and /legacy to the legacy Vue app,
# so both apps share one origin (and one login session).
MPM_DEV_API_URL=http://backend-dev:80
MPM_DEV_LEGACY_URL=http://frontend-dev:8080
