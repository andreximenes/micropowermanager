# Spark CRM backend, queue worker, scheduler and redis (shared file).
# Copy to backend.env on the VPS; values marked GENERATE are created there with openssl
# by deploy/spark/README.md and must never be committed or pasted anywhere.

APP_ENV=production
APP_DEBUG=false
APP_URL=https://crm.sparkenergy.io
# GENERATE: "base64:" + `openssl rand -base64 32`
APP_KEY=

MPM_FRONTEND_URL=https://crm.sparkenergy.io
MPM_LOAD_DEMO_DATA=false

DB_CONNECTION=micro_power_manager
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=micro_power_manager
# MPM creates one database per company, so its user needs server-wide rights.
DB_USERNAME=root
# GENERATE: must equal MYSQL_ROOT_PASSWORD in mysql.env
DB_PASSWORD=

REDIS_HOST=redis
# GENERATE: `openssl rand -hex 24`
REDIS_PASSWORD=
CACHE_DRIVER=redis

# GENERATE: `openssl rand -base64 48`
JWT_SECRET=

LOG_LEVEL=info
TELESCOPE_ENABLED=false
# Requests arrive through the PaygOps Traefik on the same host.
TRUSTEDPROXY_PROXIES=*

# The operator dashboard is not deployed; these only guard its backend endpoints.
OPERATOR_DASHBOARD_USER=operator
# GENERATE: `openssl rand -hex 24`
OPERATOR_DASHBOARD_PASSWORD=

# Never set SPARK_SHS_ALLOW_LOCAL_API_URLS here: it disables the plugin's SSRF guard.
