# The React frontend (src/web): a static SPA served by nginx. It talks to the API on the
# same origin, so it needs no runtime configuration.

FROM node:22-alpine AS build-stage
WORKDIR /app

# The vendored @spark packages are `file:` dependencies, so they must be in place before install.
COPY src/web/package.json src/web/package-lock.json ./
COPY src/web/packages ./packages
RUN npm ci

COPY src/web .

# Optional heading font, inlined by Vite at build time. Empty falls back to Roboto.
ARG VITE_HEADING_FONT_URL=""
ENV VITE_HEADING_FONT_URL=$VITE_HEADING_FONT_URL
RUN npm run build

FROM nginx:1.27-alpine AS production-stage

COPY --from=build-stage /app/dist /usr/share/nginx/html
# Client-side routes (/customers/12) have no file on disk: fall back to the SPA shell,
# and never cache it, so a deploy is picked up on the next page load.
RUN printf '%s\n' \
  'server {' \
  '  listen 80;' \
  '  root /usr/share/nginx/html;' \
  '  location /assets/ { expires 1y; add_header Cache-Control "public, immutable"; }' \
  '  location / { try_files $uri /index.html; add_header Cache-Control "no-cache"; }' \
  '}' > /etc/nginx/conf.d/default.conf

EXPOSE 80
